<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario de Reglas de Comisión -->
    <record id="view_duran_commission_rule_form" model="ir.ui.view">
        <field name="name">duran.commission.rule.form</field>
        <field name="model">duran.commission.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Comisión por Producto">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="commission_percentage"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Notas y Justificación">
                        <field name="note" nolabel="1" placeholder="Explique por qué este producto tiene una comisión preferencial o personalizada..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista de Reglas de Comisión -->
    <record id="view_duran_commission_rule_tree" model="ir.ui.view">
        <field name="name">duran.commission.rule.tree</field>
        <field name="model">duran.commission.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de Comisión por Producto" editable="bottom">
                <field name="product_id"/>
                <field name="commission_percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Vista Búsqueda de Reglas de Comisión -->
    <record id="view_duran_commission_rule_search" model="ir.ui.view">
        <field name="name">duran.commission.rule.search</field>
        <field name="model">duran.commission.rule</field>
        <field name="arch" type="xml">
            <search string="Buscar Reglas de Comisión">
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana (Act Window) -->
    <record id="action_duran_commission_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Comisión</field>
        <field name="res_model">duran.commission.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_duran_commission_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera regla de comisión por producto!
            </p>
            <p>
                Define porcentajes de comisión personalizados para productos específicos con el fin de incentivar ventas de alta gama.
            </p>
        </field>
    </record>

    <!-- Menú en Ventas > Configuración -->
    <menuitem id="menu_duran_commission_rule"
              name="Reglas de Comisión por Producto"
              parent="sale.menu_sale_config"
              action="action_duran_commission_rule"
              sequence="50"/>

</odoo>

