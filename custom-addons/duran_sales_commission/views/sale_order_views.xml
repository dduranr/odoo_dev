<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    =============================================================================
    ARCHIVO: views/sale_order_views.xml
    PROPÓSITO DIDÁCTICO:
    Este archivo hereda el formulario estándar de órdenes de venta (`sale.view_order_form`)
    para añadir:
      1. Las columnas de porcentaje (`commission_percentage`) y monto (`commission_amount`)
         dentro de la tabla de líneas de la orden (`order_line`).
      2. Un grupo o sección de resumen de comisiones (*Resumen de Comisiones de Venta*)
         mostrando el vendedor asignado, la tasa ponderada y el total de la comisión.
    =============================================================================
    -->

    <record id="view_order_form_inherit_duran_commission" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.duran.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campos de comisión en las líneas de orden (order_line) -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="after">
                <field name="commission_percentage" optional="show"/>
                <field name="commission_amount" optional="show" sum="Total Comisión Líneas"/>
            </xpath>
            
            <!-- Agregar campos de comisión en el formulario de orden de venta (pestaña o grupo de totales) -->
            <xpath expr="//group[@name='note_group']" position="before">
                <group name="commission_summary_group" string="Resumen de Comisiones de Venta">
                    <group>
                        <field name="user_id" widget="many2one_avatar_user"/>
                        <field name="commission_rate" widget="percentage"/>
                    </group>
                    <group>
                        <field name="commission_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>

